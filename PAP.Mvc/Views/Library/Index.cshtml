@model IEnumerable<PAP.DataAccess.Books>

@{
    ViewBag.Title = "Books";
    var books = Model?.ToList() ?? new List<PAP.DataAccess.Books>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Books</h1>
            <p class="text-muted mb-0">@books.Count title@(books.Count == 1 ? "" : "s") in the catalog</p>
        </div>
    </div>
    
    @if (!books.Any())
    {
        <div class="alert alert-info" role="alert">
            No books are available at this time.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Title</th>
                        <th scope="col">Author</th>
                        <th scope="col">Genre</th>
                        <th scope="col">Category</th>
                        <th scope="col">Publisher</th>
                        <th scope="col">Published</th>
                        <th scope="col" class="text-end">Price</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in books)
                    {
                        <tr>
                            <td>@book.Id</td>
                            <td>
                                <div class="fw-semibold">@book.Title</div>
                                @if (book.IsBestSeller)
                                {
                                    <span class="badge text-bg-warning">Best seller</span>
                                }
                            </td>
                            <td>@book.Author</td>
                            <td>@book.Genre</td>
                            <td>@book.Category</td>
                            <td>@book.Publisher</td>
                            <td>@book.PublicationDate</td>
                            <td class="text-end">@book.Price.ToString("C")</td>
                            <td>
                                @if (book.IsInStock)
                                {
                                    <span class="badge text-bg-success">In stock</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Out of stock</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
